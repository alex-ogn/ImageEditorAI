# Copy this file to .env and fill in your values. Never commit .env.
OPENROUTER_API_KEY=
# Vision model id from https://openrouter.ai/models
OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Prompt sent with the image when "Generate Description" is clicked.
DESCRIBE_PROMPT="Describe this image in detail. Cover the main subject, setting, composition, colors, lighting, mood and any visible text. Write clear, well-structured prose in a few short paragraphs, without preamble."
